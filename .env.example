# Copie para a raiz como `.env` (docker compose) ou exporte as variáveis. NUNCA versione o .env real.

# Banco
TF_DB_NAME=ticketflow
TF_DB_USER=ticketflow
TF_DB_PASSWORD=troque-esta-senha
# Fora do Docker: jdbc:postgresql://localhost:5432/ticketflow
TF_DB_URL=jdbc:postgresql://localhost:5432/ticketflow

# Redis (pub/sub do SSE de assentos e limitador de login) e Kafka (eventos de negócio via outbox)
TF_REDIS_HOST=localhost
TF_REDIS_PORT=6379
TF_REDIS_PASSWORD=
# Fora do Docker, com o broker do docker-compose: localhost:29092
TF_KAFKA_BOOTSTRAP=localhost:29092

# Segredos (>= 32 caracteres aleatórios cada). Gere com: openssl rand -base64 48
TF_JWT_SECRET=
# Assina o conteúdo dos QR Codes dos ingressos. Trocar invalida os QR já emitidos.
TF_QR_SECRET=
# Segredo HMAC compartilhado com o gateway de pagamento para assinar webhooks. Vazio = webhooks recusados.
TF_WEBHOOK_SECRET=

# Cookie do refresh token: true em HTTPS (produção); false apenas em http://localhost
TF_COOKIE_SECURE=false

# Frontend (CORS e links de recuperação de senha)
TF_CORS_ORIGINS=http://localhost:5173
TF_APP_URL=http://localhost:5173

# dev = catálogo de demonstração + provedor de pagamento SANDBOX (não cobra nada) + endpoint de simulação de pagamento.
# prod = logs JSON, Swagger desligado, checagem de segurança na inicialização (recusa segredos fracos, CORS aberto, cookie sem HTTPS).
# Em qualquer perfil diferente de dev/test os pagamentos respondem 503 até existir um gateway real configurado.
SPRING_PROFILES_ACTIVE=dev

# Contas de demonstração do perfil dev (organizador@ticketflow.dev, portaria@ticketflow.dev, comprador@ticketflow.dev)
TF_DEMO_PASSWORD=Demo12345

# Limite de requisições por IP e por minuto (padrões: geral 300, auth 30, portaria 240, webhooks 600)
TF_RATE_LIMIT_ENABLED=true
# TF_RATE_LIMIT_GENERAL=300
# TF_RATE_LIMIT_AUTH=30

# Documentação Swagger/OpenAPI (padrão: ligada em dev, desligada em prod)
TF_SWAGGER_ENABLED=true

# Produção atrás de proxy: regex dos proxies confiáveis para X-Forwarded-For (padrão: faixas privadas)
# TF_TRUSTED_PROXIES=10\.\d{1,3}\.\d{1,3}\.\d{1,3}

# URL base da API Spring Boot (Java 21). Usada quando VITE_USE_MOCKS=false.
VITE_API_URL=http://localhost:8080/api

# true  -> as chamadas axios são atendidas pelo servidor mock em src/mocks
# false -> as chamadas vão para VITE_API_URL
VITE_USE_MOCKS=true
