# Copie para a raiz como `.env` (docker compose) ou exporte as variáveis. NUNCA versione o .env real.

# Banco
TF_DB_NAME=ticketflow
TF_DB_USER=ticketflow
TF_DB_PASSWORD=troque-esta-senha
# Fora do Docker: jdbc:postgresql://localhost:5432/ticketflow
TF_DB_URL=jdbc:postgresql://localhost:5432/ticketflow

# Redis (pub/sub do SSE de assentos e limitador de login) e Kafka (eventos de negócio via outbox)
TF_REDIS_HOST=localhost
TF_REDIS_PORT=6379
TF_REDIS_PASSWORD=
# Fora do Docker, com o broker do docker-compose: localhost:29092
TF_KAFKA_BOOTSTRAP=localhost:29092

# Segredos (>= 32 caracteres aleatórios cada). Gere com: openssl rand -base64 48
TF_JWT_SECRET=
# Assina o conteúdo dos QR Codes dos ingressos. Trocar invalida os QR já emitidos.
TF_QR_SECRET=
# Segredo HMAC compartilhado com o gateway de pagamento para assinar webhooks. Vazio = webhooks recusados.
TF_WEBHOOK_SECRET=

# Cookie do refresh token: true em HTTPS (produção); false apenas em http://localhost
TF_COOKIE_SECURE=false

# Frontend (CORS e links de recuperação de senha)
TF_CORS_ORIGINS=http://localhost:5173
TF_APP_URL=http://localhost:5173

# dev = catálogo de demonstração + provedor de pagamento SANDBOX (não cobra nada) + endpoint de simulação de pagamento.
# Em qualquer outro perfil os pagamentos respondem 503 até existir um gateway real configurado.
SPRING_PROFILES_ACTIVE=dev
